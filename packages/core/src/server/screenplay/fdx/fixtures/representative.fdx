    <Paragraph Type="Scene Heading" Number="1A"><Text TagNumber="1">INT. WORKSHOP - NIGHT</Text></Paragraph>
    <Paragraph Type="Action"><Text>A lamp &amp; </Text><Text Style="Bold" TagNumber="2">a bell</Text><Text> flicker.</Text></Paragraph>
    <Paragraph Type="Character"><Text TagNumber="3">MARA (V.O.)</Text></Paragraph>
    <Paragraph Type="Parenthetical"><Text>(quietly, then louder)</Text></Paragraph>
