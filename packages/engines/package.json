{
  "name": "@gorenku/studio-engines",
  "version": "0.1.5",
  "description": "Standalone media provider execution library",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "license": "MIT",
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "dist/media",
    "dist/providers",
    "dist/shared",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src tests",
    "type-check": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:typecheck": "tsc --project tsconfig.vitest.json --noEmit",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "keywords": [
    "ai",
    "renku-studio",
    "engines",
    "replicate",
    "fal",
    "pika",
    "elevenlabs"
  ],
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.31.0",
    "@fal-ai/client": "^1.7.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "replicate": "^1.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitest/ui": "^3.2.4",
    "dotenv": "^17.2.3",
    "eslint": "^8",
    "eslint-config-prettier": "^10.1.8",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
