{
  "input_schema": {
    "required": [
      "prompt"
    ],
    "x-fal-order-properties": [
      "prompt",
      "duration",
      "resolution",
      "aspect_ratio",
      "reference_image_urls",
      "reference_video_urls",
      "reference_audio_urls"
    ],
    "title": "ReferenceToVideoHailuo03Input",
    "type": "object",
    "properties": {
      "aspect_ratio": {
        "title": "Aspect Ratio",
        "type": "string",
        "enum": [
          "adaptive",
          "21:9",
          "16:9",
          "4:3",
          "1:1",
          "3:4",
          "9:16"
        ],
        "description": "The aspect ratio of the generated video.",
        "default": "adaptive"
      },
      "duration": {
        "maximum": 15,
        "minimum": 5,
        "type": "integer",
        "default": 5,
        "description": "The duration of the video in seconds.",
        "title": "Duration"
      },
      "resolution": {
        "const": "2K",
        "title": "Resolution",
        "type": "string",
        "default": "2K",
        "description": "The resolution of the generated video. Only 2K is currently supported."
      },
      "prompt": {
        "minLength": 1,
        "title": "Prompt",
        "examples": [
          "Image 1 is the female protagonist. Image 2 is her small dog. Keep the woman and dog consistent with their respective reference images while they walk together through a sunlit garden."
        ],
        "type": "string",
        "maxLength": 2000,
        "description": "Text prompt for video generation. Refer to reference assets by their modality and order in the reference lists: Image 1, Image 2, Video 1, Audio 1, and so on."
      },
      "reference_video_urls": {
        "maxItems": 3,
        "title": "Reference Video Urls",
        "type": "array",
        "description": "URLs of motion/reference video clips (2-15 seconds each, combined duration at most 15 seconds), referenced in the prompt as Video 1, Video 2, and so on. Reference images, videos, and audio clips must add up to at most 12 files.",
        "items": {
          "type": "string",
          "format": "uri"
        }
      },
      "reference_image_urls": {
        "examples": [
          [
            "https://storage.googleapis.com/falserverless/example_inputs/hailuo23/pro_i2v_in.jpg"
          ]
        ],
        "title": "Reference Image Urls",
        "type": "array",
        "maxItems": 9,
        "description": "URLs of subject/style reference images, referenced in the prompt as Image 1, Image 2, and so on. Reference images, videos, and audio clips must add up to at most 12 files.",
        "items": {
          "type": "string",
          "format": "uri"
        }
      },
      "reference_audio_urls": {
        "maxItems": 3,
        "title": "Reference Audio Urls",
        "type": "array",
        "description": "URLs of reference audio clips (2-15 seconds each, combined duration at most 15 seconds), referenced in the prompt as Audio 1, Audio 2, and so on. Audio cannot be the only reference input; provide at least one reference image or video with it. Reference images, videos, and audio clips must add up to at most 12 files.",
        "items": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  },
  "output_schema": {
    "required": [
      "video"
    ],
    "x-fal-order-properties": [
      "video"
    ],
    "title": "ReferenceToVideoHailuo03Output",
    "type": "object",
    "properties": {
      "video": {
        "$ref": "#/File",
        "description": "The generated video"
      }
    }
  },
  "File": {
    "required": [
      "url"
    ],
    "x-fal-order-properties": [
      "url",
      "content_type",
      "file_name",
      "file_size"
    ],
    "title": "File",
    "type": "object",
    "properties": {
      "url": {
        "title": "Url",
        "type": "string",
        "description": "The URL where the file can be downloaded from.",
        "format": "uri"
      },
      "file_size": {
        "examples": [
          4404019
        ],
        "title": "File Size",
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "description": "The size of the file in bytes."
      },
      "content_type": {
        "examples": [
          "image/png"
        ],
        "title": "Content Type",
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "The mime type of the file."
      },
      "file_name": {
        "examples": [
          "z9RV14K95DvU.png"
        ],
        "title": "File Name",
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "The name of the file. It will be auto-generated if not provided."
      }
    }
  },
  "x-renku-viewer": {
    "version": 1,
    "input": {
      "pointer": "/input_schema",
      "component": "object",
      "label": "Input",
      "order": [
        "aspect_ratio",
        "duration",
        "resolution",
        "prompt",
        "reference_video_urls",
        "reference_image_urls",
        "reference_audio_urls"
      ],
      "fields": {
        "aspect_ratio": {
          "pointer": "/input_schema/properties/aspect_ratio",
          "component": "string-enum",
          "label": "Aspect Ratio"
        },
        "duration": {
          "pointer": "/input_schema/properties/duration",
          "component": "integer",
          "label": "Duration"
        },
        "resolution": {
          "pointer": "/input_schema/properties/resolution",
          "component": "string",
          "label": "Resolution"
        },
        "prompt": {
          "pointer": "/input_schema/properties/prompt",
          "component": "string",
          "label": "Prompt"
        },
        "reference_video_urls": {
          "pointer": "/input_schema/properties/reference_video_urls",
          "component": "array-file-uri",
          "label": "Reference Video Urls",
          "item": {
            "pointer": "/input_schema/properties/reference_video_urls/items",
            "component": "file-uri",
            "label": "Item"
          }
        },
        "reference_image_urls": {
          "pointer": "/input_schema/properties/reference_image_urls",
          "component": "array-file-uri",
          "label": "Reference Image Urls",
          "item": {
            "pointer": "/input_schema/properties/reference_image_urls/items",
            "component": "file-uri",
            "label": "Item"
          }
        },
        "reference_audio_urls": {
          "pointer": "/input_schema/properties/reference_audio_urls",
          "component": "array-file-uri",
          "label": "Reference Audio Urls",
          "item": {
            "pointer": "/input_schema/properties/reference_audio_urls/items",
            "component": "file-uri",
            "label": "Item"
          }
        }
      }
    }
  }
}
