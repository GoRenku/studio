---
import '@fontsource-variable/fraunces/index.css';
import '../styles/global.css';

import { getImage } from 'astro:assets';

import { defaultLinkPreview, site, type LinkPreview } from '../data/site';
import CookieConsent from '../components/CookieConsent.astro';
import WebsiteAnalytics from '../components/WebsiteAnalytics.astro';

interface Props {
  title?: string;
  description?: string;
  linkPreview?: LinkPreview;
}

const {
  title = `${site.name} — ${site.tagline}`,
  description = site.description,
  linkPreview = defaultLinkPreview,
} = Astro.props;

const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalUrl = new URL(pathname, Astro.site).href;
if (linkPreview.image.width < 1200 || linkPreview.image.height < 630) {
  throw new Error(
    `Link preview for ${pathname} must be at least 1200×630; ${linkPreview.image.src} is ${linkPreview.image.width}×${linkPreview.image.height}.`,
  );
}
const previewImage = await getImage({
  src: linkPreview.image,
  width: 1200,
  height: 630,
  fit: 'cover',
  position: 'top',
  format: 'jpg',
});
const previewImageUrl = new URL(previewImage.src, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Renku Journal" href="/journal/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={previewImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={linkPreview.alt} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
    <CookieConsent />
    <WebsiteAnalytics />

    <script>
      const revealables = document.querySelectorAll('[data-reveal]');
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
      );
      for (const el of revealables) observer.observe(el);
    </script>
  </body>
</html>
