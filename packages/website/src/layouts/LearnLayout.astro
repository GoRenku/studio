---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import LearnNav from '../components/LearnNav.astro';
import type { LinkPreview } from '../data/site';
import '../styles/learn.css';

interface Props { title: string; description: string; current: 'quick-start' | 'tutorials'; linkPreview?: LinkPreview; }
const { title, description, current, linkPreview } = Astro.props;
---

<BaseLayout title={title} description={description} linkPreview={linkPreview}>
  <SiteHeader />
  <main class="learn-page" id="top">
    <div class="container"><LearnNav current={current} /></div>
    <slot />
  </main>
  <SiteFooter />
</BaseLayout>
