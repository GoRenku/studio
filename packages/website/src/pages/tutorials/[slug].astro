---
import { Image } from 'astro:assets';
import LearnLayout from '../../layouts/LearnLayout.astro';
import CodexPrompt from '../../components/CodexPrompt.astro';
import { tutorials, type Tutorial } from '../../data/tutorials';
import previsVideo from '../../assets/media/harbor-blender-previs.mp4';
import generationVideo from '../../assets/media/harbor-generation.mp4';

export function getStaticPaths() {
  return tutorials.map((tutorial, index) => ({ params: { slug: tutorial.slug }, props: { tutorial, index } }));
}
interface Props { tutorial: Tutorial; index: number; }
const { tutorial, index } = Astro.props;
const previous = tutorials[index - 1];
const next = tutorials[index + 1];
---

<LearnLayout title={`${tutorial.title} — Renku Tutorials`} description={tutorial.description} current="tutorials">
  <header class="container learn-hero">
    <p class="eyebrow">Chapter 0{index + 1} · {tutorial.phase}</p><h1>{tutorial.title}</h1><p class="lede">{tutorial.description}</p>
    <div class="learn-meta"><a class="text-link" href="/tutorials/">All chapters</a><span>Learn by making one scene</span></div>
  </header>
  <div class="container reading-layout">
    <aside class="reading-nav"><p class="eyebrow">The first-scene guide</p>{tutorials.map((chapter, chapterIndex) => <a href={`/tutorials/${chapter.slug}/`} aria-current={chapter.slug === tutorial.slug ? 'page' : undefined}>0{chapterIndex + 1} · {chapter.title}</a>)}<div class="nav-divider"><p class="eyebrow">In this chapter</p>{tutorial.sections.map((section) => <a href={`#${section.id}`}>{section.title}</a>)}<a href="#checkpoint">Before moving on</a></div></aside>
    <article class="reading-content">
      <figure class="learn-image"><Image src={tutorial.image} alt={tutorial.alt} widths={[800, 1200, 1600]} sizes="800px" loading="eager" /><figcaption>{tutorial.caption}</figcaption></figure>
      <section class="lesson-section"><p class="eyebrow">Before you begin</p><p>{tutorial.prerequisite}</p><h3>What you’ll make</h3><p>{tutorial.outcome}</p></section>
      {tutorial.sections.map((section) => <section class="lesson-section" id={section.id}><h2>{section.title}</h2><p>{section.introduction}</p><ol>{section.steps.map((step) => <li>{step}</li>)}</ol>{section.prompt && <CodexPrompt prompt={section.prompt} />}{section.figure && <figure class="learn-image"><Image src={section.figure.image} alt={section.figure.alt} widths={[800, 1200, 1600]} sizes="800px" /><figcaption>{section.figure.caption}</figcaption></figure>}</section>)}
      {tutorial.slug === 'blender-previs' && <section class="lesson-section"><p class="eyebrow">See the workflow</p><h2>From rehearsal to interpretation.</h2><p>Watch the harbor previs, then its generated cinematic take. Compare the staging and camera intent across both.</p><h3>Blender Previs</h3><video class="lesson-video" controls playsinline preload="none" aria-label="Harbor Blender previs example" src={previsVideo}></video><h3>Generated take</h3><video class="lesson-video" controls playsinline preload="none" aria-label="Harbor generated video example" src={generationVideo}></video></section>}
      <section class="lesson-section" id="checkpoint"><div class="checkpoint"><p class="eyebrow">Before moving on</p><p>{tutorial.checkpoint}</p></div>{tutorial.slug === 'shot-list' && <p style="margin-top: 1rem">Ready to generate? <a href="/tutorials/video-generation/">Go straight to video generation</a>. Blender Previs is an alternative planning approach.</p>}{tutorial.slug === 'storyboards' && <p style="margin-top: 1rem">Prefer to work in 3D? <a href="/tutorials/blender-previs/">Continue with Blender Previs</a>.</p>}</section>
      <nav class="lesson-pagination" aria-label="Chapter navigation"><a href={previous ? `/tutorials/${previous.slug}/` : '/quick-start/'}><small>Previous</small>{previous?.title ?? 'Quick Start'}</a><a href={next ? `/tutorials/${next.slug}/` : '/tutorials/'}><small>{next ? 'Up next' : 'Keep creating'}</small>{next?.title ?? 'Return to all tutorials'}</a></nav>
    </article>
  </div>
</LearnLayout>
