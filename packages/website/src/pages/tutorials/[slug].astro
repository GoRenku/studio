---
import { Image } from 'astro:assets';
import LearnLayout from '../../layouts/LearnLayout.astro';
import CodexPrompt from '../../components/CodexPrompt.astro';
import { analyticsVideoName } from '../../data/analytics-video';
import { tutorialKindPresentation, tutorials, type Tutorial } from '../../data/tutorials';

export function getStaticPaths() {
  return tutorials.map((tutorial) => ({ params: { slug: tutorial.slug }, props: { tutorial } }));
}
interface Props { tutorial: Tutorial; }
const { tutorial } = Astro.props;
const presentation = tutorialKindPresentation[tutorial.kind];
const group = tutorials.filter((entry) => entry.kind === tutorial.kind);
const index = group.indexOf(tutorial);
const isChapter = tutorial.kind === 'chapter';
const previous = group[index - 1];
const next = group[index + 1];
const previousLink = previous
  ? { href: `/tutorials/${previous.slug}/`, title: previous.title }
  : isChapter ? { href: '/quick-start/', title: 'Quick Start' } : { href: '/tutorials/', title: 'All tutorials' };
const nextLabel = next ? 'Up next' : 'Keep creating';
// Tutorial pictures smaller than a link preview keep the default preview card.
const linkPreview =
  tutorial.image && tutorial.alt && tutorial.image.width >= 1200 && tutorial.image.height >= 630
    ? { image: tutorial.image, alt: tutorial.alt }
    : undefined;
---

<LearnLayout title={`${tutorial.title} — Renku Tutorials`} description={tutorial.description} current="tutorials" linkPreview={linkPreview}>
  <header class="container learn-hero">
    <p class="eyebrow">{isChapter ? `${presentation.eyebrow} 0${index + 1} · ${tutorial.phase}` : presentation.eyebrow}</p><h1>{tutorial.title}</h1><p class="lede">{tutorial.description}</p>
    <div class="learn-meta"><a class="text-link" href="/tutorials/">{presentation.indexLinkLabel}</a><span>{isChapter ? 'Learn by making one scene' : tutorial.phase}</span></div>
  </header>
  <div class="container reading-layout">
    <aside class="reading-nav"><p class="eyebrow">{presentation.sidebarTitle}</p>{group.map((entry, entryIndex) => <a href={`/tutorials/${entry.slug}/`} aria-current={entry.slug === tutorial.slug ? 'page' : undefined}>{isChapter ? `0${entryIndex + 1} · ${entry.title}` : entry.title}</a>)}<div class="nav-divider"><p class="eyebrow">{isChapter ? 'In this chapter' : 'On this page'}</p>{tutorial.sections.map((section) => <a href={`#${section.id}`}>{section.title}</a>)}<a href="#checkpoint">{presentation.checkpointLabel}</a></div></aside>
    <article class="reading-content">
      {tutorial.image && <figure class="learn-image"><Image src={tutorial.image} alt={tutorial.alt ?? ''} widths={[800, 1200, 1600]} sizes="800px" loading="eager" /><figcaption>{tutorial.caption}</figcaption></figure>}
      <section class="lesson-section"><p class="eyebrow">Before you begin</p><p>{tutorial.prerequisite}</p><h3>What you’ll do</h3><p>{tutorial.outcome}</p></section>
      {tutorial.sections.map((section) => <section class="lesson-section" id={section.id}><h2>{section.title}</h2><p>{section.introduction}</p>{section.steps.length > 0 && <ol>{section.steps.map((step) => <li>{step}</li>)}</ol>}{section.command && <pre class="tutorial-command"><code>{section.command}</code></pre>}{section.prompt && <CodexPrompt prompt={section.prompt} />}{section.figure && <figure class="learn-image"><Image src={section.figure.image} alt={section.figure.alt} widths={[800, 1200, 1600]} sizes="800px" /><figcaption>{section.figure.caption}</figcaption></figure>}{section.videos?.map((video) => <><h3>{video.title}</h3><video class="lesson-video" controls playsinline preload="none" aria-label={video.label} src={video.src} data-analytics-video={analyticsVideoName(video.src)}>{video.captions && <track kind="captions" srclang="en" label="English" src={video.captions} default />}</video></>)}{section.link && <p><a href={section.link.href}>{section.link.label} →</a></p>}</section>)}
      <section class="lesson-section" id="checkpoint"><div class="checkpoint"><p class="eyebrow">{presentation.checkpointLabel}</p><p>{tutorial.checkpoint}</p></div>{(tutorial.slug === 'shot-list' || tutorial.slug === 'blender-previs') && <p>For scenes with dialogue, <a href="/tutorials/video-generation/#dialogue-audio">generate and select the Shot Plan’s audio takes</a> before preparing video.</p>}{tutorial.slug === 'shot-list' && <p style="margin-top: 1rem">Ready to generate? <a href="/tutorials/video-generation/">Go straight to video generation</a>. Blender Previs is an alternative planning approach.</p>}{tutorial.slug === 'storyboards' && <p style="margin-top: 1rem">Prefer to work in 3D? <a href="/tutorials/blender-previs/">Continue with Blender Previs</a>.</p>}</section>
      <nav class="lesson-pagination" aria-label="Tutorial navigation"><a href={previousLink.href}><small>Previous</small>{previousLink.title}</a><a href={next ? `/tutorials/${next.slug}/` : '/tutorials/'}><small>{nextLabel}</small>{next?.title ?? 'Return to all tutorials'}</a></nav>
    </article>
  </div>
</LearnLayout>
