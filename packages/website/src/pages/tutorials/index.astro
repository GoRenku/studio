---
import { Image } from 'astro:assets';
import LearnLayout from '../../layouts/LearnLayout.astro';
import { tutorials } from '../../data/tutorials';
import hero from '../../assets/screens/harbor-blender-previs.jpg';
---

<LearnLayout title="Renku Tutorials — From screenplay to screen" description="A practical filmmaking course: Inspiration, Lookbooks, Cast, Locations, Props, Scene Beats, Storyboards, Shot Lists, Blender Previs, and AI video generation." current="tutorials">
  <header class="container learn-hero learn-split">
    <div><p class="eyebrow">The first-scene guide</p><h1>From a spark<br />to the <em>screen.</em></h1><p class="lede">Make one scene, all the way through. Find its visual language, build its world, and direct a take worth keeping.</p><div class="hero-actions"><a class="btn btn-primary" href="/tutorials/inspiration/">Start with inspiration</a><a class="text-link" href="#chapters">Browse chapters</a></div><div class="learn-meta"><span>8 focused chapters</span><span>Your screenplay · Your pace</span></div></div>
    <figure class="learn-image"><Image src={hero} alt="A harbor scene moving from Blender staging to a cinematic generated take." widths={[800, 1200, 1600]} sizes="50vw" loading="eager" /><figcaption>A scene, from the first camera decision to its cinematic interpretation.</figcaption></figure>
  </header>
  <section class="container" id="chapters" style="scroll-margin-top: 6rem">
    <div class="course-heading"><div><p class="eyebrow">The creative path</p><h2>Build the film in layers.</h2></div><p>New to Renku? <a class="text-link" href="/quick-start/">Complete Quick Start first.</a></p></div>
    <div class="chapter-grid">{tutorials.map((tutorial, index) => <a class="chapter-card" href={`/tutorials/${tutorial.slug}/`}><Image src={tutorial.image} alt={tutorial.alt} widths={[480, 720, 1000]} sizes="(min-width: 1000px) 33vw, 50vw" /><div class="chapter-card-copy"><span class="eyebrow">0{index + 1} · {tutorial.phase}</span><h3>{tutorial.title}</h3><p>{tutorial.description}</p><span class="chapter-link">Read chapter {index + 1}</span></div></a>)}</div>
    <div class="next-lesson"><div><p class="eyebrow">Two ways to plan</p><h2>Compose the coverage. Or stage the motion.</h2><p>Follow chapters 1–5, then choose Shot List or Blender Previs. Both lead to video generation.</p></div><a class="btn btn-ghost" href="/tutorials/shot-list/">Explore shot planning</a></div>
  </section>
</LearnLayout>
