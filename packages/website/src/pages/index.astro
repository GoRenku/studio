---
import AudienceSection from '../components/AudienceSection.astro';
import CtaSection from '../components/CtaSection.astro';
import FaqSection from '../components/FaqSection.astro';
import FeatureSection from '../components/FeatureSection.astro';
import Hero from '../components/Hero.astro';
import ShotPlanningSection from '../components/ShotPlanningSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import VideoFeatureSection from '../components/VideoFeatureSection.astro';
import WorkflowStrip from '../components/WorkflowStrip.astro';
import { features, shotPlanVideoFeature } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <SiteHeader />
  <main>
    <Hero />
    <WorkflowStrip />
    <div id="features">
      {
        features.map((feature, i) => (
          <FeatureSection feature={feature} flip={i % 2 === 1} />
        ))
      }
      <ShotPlanningSection />
      <VideoFeatureSection feature={shotPlanVideoFeature} />
    </div>
    <AudienceSection />
    <FaqSection />
    <CtaSection />
  </main>
  <SiteFooter />
</BaseLayout>
