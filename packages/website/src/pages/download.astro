---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import LearnNav from '../components/LearnNav.astro';

const macCommand = 'curl -fsSL https://downloads.gorenku.com/install.sh | sh';
const windowsCommand = 'irm https://downloads.gorenku.com/install.ps1 | iex';
const launchCommand = 'renku studio start';

// Real requests from the Urban Basilica film, priced at list prices on 15 Oct 2026.
// Refresh all three together, from real project records, when prices change.
const generationCostExamples = [
  {
    // Scene 03 storyboard iteration 02 (s03-b01…b04), one request, 26 Aug 2026;
    // Codex built-in image generation, so no provider bill.
    title: 'Storyboard pass',
    detail: 'Four Beat frames for one scene in a single image, made with Codex’s built-in image generation (26 Aug 2026).',
    cost: 'No provider charge',
    costNote: 'Uses your ChatGPT plan’s Codex usage. With Claude or another agent, storyboards use an image provider’s prices.',
  },
  {
    // asset_file_exnux9d4, Fal.ai request 01a1256a-e327-7c91-8fd6-01ebbfd87101, 10 Oct 2026.
    // fal.ai/models/minimax/h3-max/reference-to-video: 15 s × $0.08 at 768p = $1.20; reference
    // tokens 4 × 1,824 (16:9 images) + 102,816 (15 s 24 fps 16:9 video) + 1,198 (14.98 s audio)
    // = 111,310, minus 4,096 included, × $0.02 per 1,000 = $2.14.
    title: 'Video take',
    detail: '15 seconds at 768p with MiniMax H3 Max on Fal.ai, guided by four reference images, a previs video and the dialogue audio (10 Oct 2026).',
    cost: '$3.34',
    costNote: '$1.20 for the video plus $2.14 for the reference inputs.',
  },
  {
    // asset_file_chmraa77, 10 Oct 2026; elevenlabs.io/pricing/api: Eleven v4 $0.08 per 1,000
    // characters on pay as you go; 54 characters = $0.0043.
    title: 'Voice line',
    detail: 'One line of dialogue, 54 characters, with ElevenLabs Eleven v4 (10 Oct 2026).',
    cost: '$0.004',
    costNote: 'Pay-as-you-go API price.',
  },
];
---

<BaseLayout
  title="Download Renku — Install for macOS or Windows"
  description="Install the Renku desktop beta for macOS or Windows, add skills to your AI agent, and start your local filmmaking studio for live action and AI."
>
  <SiteHeader />
  <main class="install-page" id="top">
    <div class="install-glow" aria-hidden="true"></div>
    <div class="container install-navigation"><LearnNav current="download" /></div>

    <section class="container install-hero">
      <a class="back-link" href="/">← Back to Renku</a>
      <p class="eyebrow" data-reveal>Desktop beta</p>
      <h1 data-reveal style="--reveal-delay: 0.06s">
        Bring the studio <em>home.</em>
      </h1>
      <p class="install-intro" data-reveal style="--reveal-delay: 0.12s">
        Renku runs locally on your computer, close to your screenplay and media.
        Use it alongside your AI agent: give direction in the agent app and review your film in Studio.
      </p>
    </section>

    <section class="container install-before" aria-labelledby="before-heading">
      <div class="before-needs" data-reveal>
        <p class="eyebrow">Before you start</p>
        <h2 id="before-heading">What you’ll need</h2>
        <dl class="need-list">
          <div>
            <dt>A Mac or Windows PC</dt>
            <dd>macOS 13.5 or newer on Apple silicon or Intel, or Windows 10 (version 1803 or newer) or Windows 11 on x64.</dd>
          </div>
          <div>
            <dt>An AI agent app</dt>
            <dd>Renku has no built-in agent. <a href="https://learn.chatgpt.com/docs/app" target="_blank" rel="noreferrer">Codex in the ChatGPT app</a> is included with ChatGPT plans, including Free; usage limits depend on the plan. <a href="https://claude.com/download" target="_blank" rel="noreferrer">Claude Desktop</a>’s Code tab needs a paid Claude plan (Pro or higher). A terminal agent, or another app that can run local commands and use Renku’s skills, works too. Desktop apps are recommended so you can see images beside the conversation.</dd>
            <dd class="need-checked">Plans checked 15 Oct 2026: <a href="https://learn.chatgpt.com/docs/pricing" target="_blank" rel="noreferrer">OpenAI pricing</a> · <a href="https://claude.com/pricing" target="_blank" rel="noreferrer">Claude pricing</a></dd>
          </div>
          <div>
            <dt>An API key with credit</dt>
            <dd>To generate images, video or voices, add an API key from at least one provider Renku supports: Fal.ai, Pika, Replicate, WaveSpeed, ElevenLabs or World Labs. You pay the provider directly; Renku adds no fee. With Codex, some images can use its built-in image generation instead.</dd>
          </div>
        </dl>
      </div>
      <div class="before-costs" data-reveal style="--reveal-delay: 0.06s">
        <p class="eyebrow">What generation costs</p>
        <h2>Three real examples</h2>
        <p class="costs-intro">Renku is free. Your provider bills each generation. These are real requests from making our Basilica film, priced at list prices on 15 Oct 2026.</p>
        <ul class="cost-list">
          {generationCostExamples.map((example) => (
            <li>
              <div class="cost-heading">
                <h3>{example.title}</h3>
                <strong>{example.cost}</strong>
              </div>
              <p>{example.detail}</p>
              <p class="cost-note">{example.costNote}</p>
            </li>
          ))}
        </ul>
        <p class="costs-note">A retake costs the same again. Prices change, so check your provider. When a provider publishes its prices, Renku shows an estimate before you confirm a generation.</p>
      </div>
    </section>

    <section class="container install-workflow" aria-labelledby="install-heading">
      <div class="install-heading-row" data-reveal>
        <div>
          <p class="eyebrow">Installation</p>
          <h2 id="install-heading">Three steps to get started</h2>
        </div>
      </div>
      <p class="install-terms">Before installing Renku, the installer asks you to read and accept the <a href="/terms/">Terms of Use</a>. It remembers your answer for updates and asks again only if the terms change. You can also review the <a href="/privacy/">Privacy Notice</a>. Renku Studio’s AGPLv3 license and the Skills’ MIT license govern your open-source rights independently.</p>

      <div class="platform-tabs" role="tablist" aria-label="Operating system" data-reveal>
        <button
          class="platform-tab is-selected"
          type="button"
          role="tab"
          id="mac-tab"
          aria-controls="mac-panel"
          aria-selected="true"
          data-platform-tab="mac"
        >
          <span>macOS</span>
          <small>Apple silicon + Intel</small>
        </button>
        <button
          class="platform-tab"
          type="button"
          role="tab"
          id="windows-tab"
          aria-controls="windows-panel"
          aria-selected="false"
          tabindex="-1"
          data-platform-tab="windows"
        >
          <span>Windows</span>
          <small>Native x64 PowerShell</small>
        </button>
      </div>

      <div class="platform-panel" id="mac-panel" role="tabpanel" aria-labelledby="mac-tab" data-platform-panel="mac">
        <div class="step-intro">
          <span class="step-number">01</span>
          <div>
            <h3>Install Renku</h3>
            <p>Open Terminal, paste this command, and press Return.</p>
          </div>
        </div>
        <div class="command-block">
          <span class="command-prompt" aria-hidden="true">$</span>
          <code>{macCommand}</code>
          <button class="copy-button" type="button" data-copy={macCommand} aria-label="Copy macOS install command">Copy</button>
        </div>
        <p class="command-note">
          If Git is missing, setup opens Apple’s Command Line Tools installer. Finish that dialog, then press Return in Terminal to continue.
        </p>
      </div>

      <div class="platform-panel" id="windows-panel" role="tabpanel" aria-labelledby="windows-tab" data-platform-panel="windows" hidden>
        <div class="step-intro">
          <span class="step-number">01</span>
          <div>
            <h3>Install Renku</h3>
            <p>Open PowerShell, paste this command, and press Enter.</p>
          </div>
        </div>
        <div class="command-block">
          <span class="command-prompt" aria-hidden="true">PS</span>
          <code>{windowsCommand}</code>
          <button class="copy-button" type="button" data-copy={windowsCommand} aria-label="Copy Windows install command">Copy</button>
        </div>
      </div>

      <div class="install-step" data-reveal>
        <div class="step-intro">
          <span class="step-number">02</span>
          <div>
            <h3>Let setup connect your agent</h3>
            <p>Setup automatically installs the Renku plugin for Claude and Codex when their CLI or desktop app is available. There is no agent picker. These plugins teach your agent how to work with Renku.</p>
            <p>For Claude Desktop, open its Code tab once before running setup. After installation, start a new local Code conversation and invoke <code>/renku:movie-director</code>. Standalone Claude Code is supported too.</p>
            <p>Restart the ChatGPT app after setup to load the Codex plugin. Renku does not install the agent apps themselves. Using another agent? Follow the <a href="/agent-skills/">separate skills installation guide</a>.</p>
          </div>
        </div>
      </div>

      <div class="install-step launch-step" data-reveal>
        <div class="step-intro">
          <span class="step-number">03</span>
          <div>
            <h3>Start the studio</h3>
            <p data-platform-panel="mac">Open a new Terminal window and run this command to open Studio in your browser.</p>
            <p data-platform-panel="windows" hidden>Run this command in the same PowerShell window to open Studio in your browser.</p>
            <p>Follow the first-run setup. Restart your agent and start a new conversation to load the Renku skills.</p>
          </div>
        </div>
        <div class="command-block command-block-launch" data-platform-panel="mac">
          <span class="command-prompt" aria-hidden="true">$</span>
          <code>{launchCommand}</code>
          <button class="copy-button" type="button" data-copy={launchCommand} aria-label="Copy macOS launch command">Copy</button>
        </div>
        <div class="command-block command-block-launch" data-platform-panel="windows" hidden>
          <span class="command-prompt" aria-hidden="true">PS</span>
          <code>{launchCommand}</code>
          <button class="copy-button" type="button" data-copy={launchCommand} aria-label="Copy Windows launch command">Copy</button>
        </div>
        <p class="command-note">Keep this terminal open while using Studio. Run the same command whenever you want to start Renku again.</p>
      </div>
    </section>

    <section class="container install-next" aria-labelledby="next-heading">
      <div><p class="eyebrow">Up and running?</p><h2 id="next-heading">Make room for your first film.</h2><p>Connect your providers, create a project, and bring your screenplay into Studio.</p></div>
      <a class="btn btn-primary" href="/quick-start/">Continue to Quick Start</a>
    </section>

    <section class="container install-details" aria-label="Installation details">
      <div data-reveal>
        <p class="detail-label">Private by default</p>
        <h3>Your project stays on your machine.</h3>
        <p>Studio runs as a local web application. Your project database and media remain in folders you control.</p>
      </div>
      <div data-reveal style="--reveal-delay: 0.06s">
        <p class="detail-label">Safe updates</p>
        <h3>Versioned and verified.</h3>
        <p>Stop Studio, then run <code>renku update</code> to update Renku and its Claude/Codex plugins. Use <code>renku update skills</code> to refresh those plugins without updating the runtime. Other agents use the <a href="/agent-skills/">separate skills installation guide</a>.</p>
        <p>If your installed updater reports a missing bundled skills installer, stop Studio and rerun the installation command above. It downloads the current installer and preserves your projects and settings.</p>
      </div>
      <div data-reveal style="--reveal-delay: 0.12s">
        <p class="detail-label">Open development</p>
        <h3>See how Renku is built.</h3>
        <p>Browse the source, follow releases, or report an issue on <a href="https://github.com/GoRenku/studio" target="_blank" rel="noreferrer">GitHub →</a></p>
      </div>
    </section>
  </main>
  <SiteFooter />

  <p class="copy-status" role="status" aria-live="polite"></p>

  <script>
    const tabs = Array.from(document.querySelectorAll<HTMLElement>('[data-platform-tab]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-platform-panel]'));
    const status = document.querySelector<HTMLElement>('.copy-status');

    function selectPlatform(platform: string) {
      for (const tab of tabs) {
        const selected = tab.dataset.platformTab === platform;
        tab.classList.toggle('is-selected', selected);
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
      }

      for (const panel of panels) {
        panel.hidden = panel.dataset.platformPanel !== platform;
      }
    }

    for (const tab of tabs) {
      tab.addEventListener('click', () => selectPlatform(tab.dataset.platformTab ?? 'mac'));
      tab.addEventListener('keydown', (event) => {
        const isLeft = event.key === 'ArrowLeft' || event.key === 'Left';
        const isRight = event.key === 'ArrowRight' || event.key === 'Right';
        if (!isLeft && !isRight) return;

        event.preventDefault();
        const currentIndex = tabs.indexOf(tab);
        const direction = isRight ? 1 : -1;
        const nextTab = tabs[(currentIndex + direction + tabs.length) % tabs.length];
        selectPlatform(nextTab.dataset.platformTab ?? 'mac');
        nextTab.focus();
      });
    }

    const detectedPlatform = `${navigator.platform} ${navigator.userAgent}`;
    if (/win/i.test(detectedPlatform)) selectPlatform('windows');

    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
      button.addEventListener('click', async () => {
        const value = button.dataset.copy;
        if (!value) return;

        const previous = button.textContent;
        try {
          await navigator.clipboard.writeText(value);
          button.textContent = 'Copied';
          if (status) status.textContent = 'Command copied to clipboard.';
        } catch {
          button.textContent = 'Try again';
          if (status) status.textContent = 'The command could not be copied.';
        }

        window.setTimeout(() => {
          button.textContent = previous;
          if (status) status.textContent = '';
        }, 1800);
      });
    }
  </script>
</BaseLayout>

<style>
  .install-navigation { position: relative; padding-top: 5rem; }
  .install-next { display: flex; align-items: center; justify-content: space-between; gap: 2rem; margin-block: 3rem; }
  .install-next h2 { font-size: 2rem; margin-block: 0.6rem; }
  .install-next p:not(.eyebrow) { color: var(--paper-500); font-size: 0.95rem; }
  .install-next .btn { flex-shrink: 0; }
  @media (max-width: 800px) { .install-next { flex-direction: column; align-items: start; } }
  .install-page {
    position: relative;
    overflow: hidden;
    padding-bottom: clamp(5rem, 12vh, 8rem);
  }

  .install-glow {
    position: absolute;
    inset: -12rem -16rem auto;
    height: 52rem;
    pointer-events: none;
    background:
      radial-gradient(36rem 24rem at 26% 28%, rgba(253, 160, 45, 0.15), transparent 68%),
      radial-gradient(34rem 22rem at 78% 10%, rgba(30, 179, 176, 0.08), transparent 68%);
  }

  .install-hero {
    position: relative;
    max-width: 54rem;
    padding-top: clamp(3rem, 7vh, 5rem);
    padding-bottom: clamp(3.5rem, 8vh, 5rem);
    text-align: center;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2.4rem;
    font-size: 0.82rem;
    color: var(--paper-500);
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--amber-400);
  }

  h1 {
    margin-top: 1.1rem;
    font-size: clamp(2.8rem, 7vw, 5.4rem);
  }

  h1 em {
    color: var(--amber-400);
    font-weight: 400;
  }

  .install-intro {
    max-width: 43rem;
    margin: 1.5rem auto 0;
    font-size: clamp(1rem, 1.6vw, 1.16rem);
    color: var(--paper-300);
  }

  .install-before {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    max-width: 64rem;
    margin-bottom: clamp(2rem, 5vh, 3rem);
    border: 1px solid rgba(244, 239, 230, 0.1);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--ink-850) 82%, transparent);
    box-shadow: 0 32px 80px -40px rgba(0, 0, 0, 0.9);
  }

  .install-before > div {
    padding: clamp(1.5rem, 4vw, 2.6rem);
  }

  .install-before > div + div {
    border-left: 1px solid rgba(244, 239, 230, 0.08);
  }

  .install-before h2 {
    margin-top: 0.55rem;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
  }

  .need-list {
    margin: 1.4rem 0 0;
  }

  .need-list > div + div {
    margin-top: 1.2rem;
    padding-top: 1.2rem;
    border-top: 1px solid rgba(244, 239, 230, 0.08);
  }

  .need-list dt,
  .cost-list h3 {
    font-family: var(--font-body);
    font-size: 0.98rem;
    font-weight: 650;
    letter-spacing: 0;
  }

  .need-list dd {
    margin: 0.35rem 0 0;
    font-size: 0.88rem;
    color: var(--paper-500);
  }

  .need-list dd.need-checked {
    font-size: 0.8rem;
    color: var(--paper-700);
  }

  .install-before a {
    color: var(--amber-400);
  }

  .costs-intro {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: var(--paper-300);
  }

  .cost-list {
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .cost-list li {
    padding-block: 1.1rem;
    border-top: 1px solid rgba(244, 239, 230, 0.08);
  }

  .cost-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .cost-heading strong {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--amber-400);
    white-space: nowrap;
  }

  .cost-list li p {
    margin-top: 0.3rem;
    font-size: 0.85rem;
    color: var(--paper-500);
  }

  .cost-list li p.cost-note {
    font-size: 0.78rem;
    color: var(--paper-700);
  }

  .costs-note {
    padding-top: 1rem;
    border-top: 1px solid rgba(244, 239, 230, 0.08);
    font-size: 0.8rem;
    color: var(--paper-700);
  }

  .install-workflow {
    position: relative;
    max-width: 64rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid rgba(244, 239, 230, 0.1);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--ink-850) 82%, transparent);
    box-shadow: 0 32px 80px -40px rgba(0, 0, 0, 0.9);
  }

  .install-heading-row {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .install-heading-row h2 {
    margin-top: 0.55rem;
    font-size: clamp(1.9rem, 4vw, 2.7rem);
  }

  .install-terms {
    margin-top: 1.5rem;
    color: var(--paper-300);
    font-size: 0.9rem;
  }

  .install-terms a {
    color: var(--amber-400);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .install-terms a:hover,
  .install-terms a:focus-visible { color: var(--paper-100); }

  .platform-tabs {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.7rem;
    margin-top: 2.4rem;
    padding-bottom: 2.4rem;
    border-bottom: 1px solid rgba(244, 239, 230, 0.08);
  }

  .platform-tab {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.95rem 1.1rem;
    border: 1px solid var(--ink-600);
    border-radius: var(--radius-md);
    background: var(--ink-900);
    color: var(--paper-300);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
  }

  .platform-tab:hover {
    border-color: rgba(253, 160, 45, 0.5);
  }

  .platform-tab:focus-visible {
    outline: 2px solid var(--amber-400);
    outline-offset: 3px;
  }

  .platform-tab.is-selected {
    border-color: var(--amber-500);
    background: var(--accent-soft);
    color: var(--paper-100);
  }

  .platform-tab span {
    font-weight: 650;
  }

  .platform-tab small {
    color: var(--paper-700);
  }

  .platform-panel,
  .install-step {
    padding-top: 2.5rem;
  }

  [data-platform-panel][hidden] {
    display: none;
  }

  .install-step {
    margin-top: 2.7rem;
    border-top: 1px solid rgba(244, 239, 230, 0.08);
  }

  .step-intro {
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    gap: 1.1rem;
  }

  .step-number {
    padding-top: 0.1rem;
    font-family: var(--font-display);
    color: var(--amber-500);
  }

  .step-intro h3 {
    font-family: var(--font-body);
    font-size: 1.02rem;
    font-weight: 650;
    letter-spacing: 0;
  }

  .step-intro p {
    max-width: 46rem;
    margin-top: 0.35rem;
    font-size: 0.9rem;
    color: var(--paper-500);
  }

  .command-block {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.85rem;
    margin-top: 1.25rem;
    min-height: 4.5rem;
    padding: 0.75rem 0.8rem 0.75rem 1.15rem;
    border: 1px solid rgba(253, 160, 45, 0.68);
    background: var(--ink-950);
  }

  .command-block-quiet {
    border-color: rgba(244, 239, 230, 0.14);
  }

  .command-block-launch {
    border-color: rgba(30, 179, 176, 0.55);
  }

  .command-prompt {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.88rem;
    color: var(--amber-400);
  }

  .command-block-launch .command-prompt {
    color: var(--teal-500);
  }

  .command-block code {
    overflow-x: auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: clamp(0.78rem, 1.5vw, 0.96rem);
    white-space: nowrap;
    color: var(--paper-100);
  }

  .copy-button {
    min-width: 4.4rem;
    padding: 0.62rem 0.75rem;
    border: 1px solid var(--ink-600);
    border-radius: 8px;
    background: var(--ink-850);
    color: var(--paper-300);
    font: 600 0.76rem/1 var(--font-body);
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  }

  .copy-button:hover,
  .copy-button:focus-visible {
    border-color: var(--amber-500);
    color: var(--paper-100);
    background: var(--accent-soft);
  }

  .command-note {
    margin: 0.8rem 0 0 3.5rem;
    font-size: 0.8rem;
    color: var(--paper-700);
  }

  .command-note code {
    color: var(--paper-300);
  }

  .command-note strong {
    color: var(--paper-300);
  }

  .step-intro a { color: var(--amber-400); }

  .launch-step {
    padding-bottom: 0.2rem;
  }

  .launch-step .command-block {
    margin-left: 3.5rem;
  }

  .install-details {
    display: grid;
