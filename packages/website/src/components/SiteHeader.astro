---
import { Image } from 'astro:assets';

import githubMark from '../assets/icons/github-mark.svg';
import logo from '../assets/renku-logo.svg';
import { studioStarCount, studioStarCountShownFrom } from '../data/github-stars';
import { site } from '../data/site';

const shownStarCount =
  studioStarCount !== undefined && studioStarCount >= studioStarCountShownFrom
    ? studioStarCount.toLocaleString('en-US')
    : undefined;
const starLabel = shownStarCount
  ? `Star Renku Studio on GitHub, ${shownStarCount} stars`
  : 'Star Renku Studio on GitHub';
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/#top" class="brand">
      <Image src={logo} alt="" width="34" height="38" loading="eager" />
      <span class="brand-name">renku</span>
    </a>
    <nav class="site-nav" aria-label="Main">
      <a href="/#features">Features</a>
      <a href="/quick-start/">Quick Start</a>
      <a href="/tutorials/">Tutorials</a>
      <a href="/journal/">Journal</a>
    </nav>
    <div class="header-actions">
      <a
        href={site.githubUrl}
        class="github-star"
        aria-label={starLabel}
        target="_blank"
        rel="noreferrer"
      >
        <Image src={githubMark} alt="" width="18" height="18" loading="eager" />
        <span class="github-star-label">Star on GitHub</span>
        {shownStarCount && <span class="github-star-count">{shownStarCount}</span>}
      </a>
      <a href={site.downloadUrl} class="btn btn-primary header-cta">Download Renku</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    background: color-mix(in srgb, var(--ink-950) 72%, transparent);
    border-bottom: 1px solid rgba(244, 239, 230, 0.06);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 4.25rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .site-nav {
    display: flex;
    gap: 1.75rem;
    margin-inline-start: auto;
    font-size: 0.92rem;
    color: var(--paper-300);
  }

  .site-nav a {
    transition: color 0.2s ease;
  }

  .site-nav a:hover {
    color: var(--amber-400);
  }

  .header-actions {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.75rem;
  }

  .github-star {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.25rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid rgba(244, 239, 230, 0.14);
    border-radius: 999px;
    color: var(--paper-300);
    font-size: 0.82rem;
    font-weight: 550;
    white-space: nowrap;
    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      color 0.2s ease;
  }

  .github-star:hover {
    border-color: rgba(253, 160, 45, 0.5);
    background: rgba(244, 239, 230, 0.06);
    color: var(--paper-100);
  }

  .github-star:focus-visible {
    outline: 2px solid var(--amber-400);
    outline-offset: 3px;
  }

  .github-star img {
    display: block;
    width: 1.1rem;
    height: 1.1rem;
  }

  .github-star-count {
    padding-left: 0.55rem;
    border-left: 1px solid rgba(244, 239, 230, 0.16);
    color: var(--paper-100);
    font-variant-numeric: tabular-nums;
  }

  .header-cta {
    padding: 0.6rem 1.15rem;
    font-size: 0.88rem;
  }

  @media (max-width: 640px) {
    .site-nav {
      display: none;
    }

    .header-inner {
      justify-content: space-between;
    }

    .github-star-label {
      display: none;
    }

    .github-star {
      padding-inline: 0.6rem;
    }
  }
</style>
