---
import { Image } from 'astro:assets';

import logo from '../assets/renku-logo.svg';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-identity">
      <div class="footer-brand">
        <Image src={logo} alt="" width="26" height="29" />
        <span>renku</span>
      </div>
      <p class="footer-legal">© {year} Kerem Karatal</p>
    </div>
    <nav class="footer-links" aria-label="Legal and privacy">
      <a href="/terms/">Terms of Use</a>
      <a href="/privacy/">Privacy Notice</a>
      <button class="cookie-settings" type="button" data-cookie-settings>Analytics choice</button>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid rgba(244, 239, 230, 0.07);
    padding-block: 2rem;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .footer-identity {
    display: flex;
    align-items: center;
    gap: 2rem;
    white-space: nowrap;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    color: var(--paper-300);
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .footer-legal {
    color: var(--paper-500);
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .cookie-settings {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .footer-links a:hover,
  .footer-links a:focus-visible,
  .cookie-settings:hover,
  .cookie-settings:focus-visible { color: var(--amber-400); }
</style>
