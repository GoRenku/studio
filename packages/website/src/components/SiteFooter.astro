---
import { Image } from 'astro:assets';

import logo from '../assets/renku-logo.svg';
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-main">
    <a href="/#top" class="footer-brand">
      <Image src={logo} alt="" width="26" height="29" />
      <span>renku</span>
    </a>
    <nav class="footer-columns" aria-label="Renku project">
      <div>
        <p class="footer-heading">Source code</p>
        <a href={site.githubUrl} target="_blank" rel="noreferrer">Renku Studio</a>
        <a href={site.studioSkillsGithubUrl} target="_blank" rel="noreferrer">Studio Skills</a>
      </div>
      <div>
        <p class="footer-heading">Community</p>
        <a href={site.githubDiscussionsUrl} target="_blank" rel="noreferrer">Discussions</a>
        <a href={site.latentMatineeUrl} target="_blank" rel="noreferrer">Latent Matinee</a>
      </div>
    </nav>
  </div>
  <div class="container footer-bottom">
    <p class="footer-legal">© {year} Kerem Karatal</p>
    <nav class="footer-links" aria-label="Legal and privacy">
      <a href="/terms/">Terms of Use</a>
      <a href="/privacy/">Privacy Notice</a>
      <button class="cookie-settings" type="button" data-cookie-settings>Analytics choice</button>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid rgba(244, 239, 230, 0.07);
    padding-block: 3rem 2rem;
  }

  .footer-main {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 3rem;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
  }

  .footer-columns {
    display: flex;
    gap: clamp(3rem, 8vw, 6rem);
  }

  .footer-columns div {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-size: 0.85rem;
    color: var(--paper-300);
  }

  .footer-heading {
    margin-bottom: 0.2rem;
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--paper-700);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(244, 239, 230, 0.05);
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    color: var(--paper-500);
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .footer-legal {
    color: var(--paper-700);
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .cookie-settings {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .footer-columns a,
  .footer-links a,
  .cookie-settings {
    transition: color 0.2s ease;
  }

  .footer-columns a:hover,
  .footer-columns a:focus-visible,
  .footer-links a:hover,
  .footer-links a:focus-visible,
  .cookie-settings:hover,
  .cookie-settings:focus-visible { color: var(--amber-400); }

  @media (max-width: 640px) {
    .footer-main,
    .footer-bottom {
      flex-direction: column;
      align-items: start;
    }
  }
</style>
