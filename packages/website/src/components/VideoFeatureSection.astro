---
import falWordmark from '../assets/providers/fal-wordmark.svg?url';
import pikaWordmark from '../assets/providers/pika-wordmark.svg?url';
import replicateWordmark from '../assets/providers/replicate-wordmark.svg?url';
import waveSpeedWordmark from '../assets/providers/wavespeed-wordmark.svg?url';
import elevenLabsWordmark from '../assets/providers/elevenlabs-wordmark.svg?url';
import worldLabsWordmark from '../assets/providers/worldlabs-wordmark.svg?url';

interface Props {
  feature: {
    id: string;
    eyebrow: string;
    title: string;
    description: string;
    bullets: string[];
    video: string;
    videoLabel: string;
  };
}

const { feature } = Astro.props;
const providers = [
  { name: 'fal.ai', image: falWordmark, width: '4.1rem' },
  { name: 'Pika', image: pikaWordmark, width: '4.4rem' },
  { name: 'Replicate', image: replicateWordmark, width: '7.1rem' },
  { name: 'WaveSpeed', image: waveSpeedWordmark, width: '8.8rem' },
  { name: 'ElevenLabs', image: elevenLabsWordmark, width: '8rem' },
  { name: 'World Labs', image: worldLabsWordmark, width: '9rem' },
];
---

<section id={feature.id} class="feature video-feature">
  <div class="container feature-inner">
    <div class="feature-copy" data-reveal>
      <p class="eyebrow">{feature.eyebrow}</p>
      <h2>{feature.title}</h2>
      <p class="feature-desc">{feature.description}</p>
      <ul class="feature-bullets">
        {
          feature.bullets.map((bullet) => (
            <li>
              <svg
                viewBox="0 0 16 16"
                width="16"
                height="16"
                aria-hidden="true"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M2.5 8.5l3.5 3.5 7.5-8" />
              </svg>
              <span>{bullet}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="feature-media" data-reveal style="--reveal-delay: 0.12s">
      <figure class="shot video-shot">
        <video
          autoplay
          muted
          playsinline
          preload="metadata"
          aria-label={feature.videoLabel}
        >
          <source src={feature.video} type="video/mp4" />
        </video>
        <figcaption>
          <span class="live-mark" aria-hidden="true"></span>
          The First Patron · Shot Plan Video · 12 seconds
        </figcaption>
      </figure>
    </div>
  </div>
  <div class="container" data-reveal>
    <div class="provider-network">
      <p>Connected providers</p>
      <ul aria-label="Connected generation providers">
        {providers.map((provider) => (
          <li><img src={provider.image} alt={provider.name} style={`width: ${provider.width};`} loading="lazy" /></li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .feature {
    padding-block: clamp(3.5rem, 9vh, 6.5rem);
  }

  .video-feature {
    padding-top: clamp(2rem, 5vh, 3.5rem);
  }

  .feature-inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }

  h2 {
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    margin-top: 0.9rem;
  }

  .feature-desc {
    margin-top: 1.1rem;
    color: var(--paper-300);
  }

  .feature-bullets {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    gap: 0.7rem;
  }

  .feature-bullets li {
    display: flex;
    gap: 0.65rem;
    align-items: baseline;
    font-size: 0.95rem;
    color: var(--paper-300);
  }

  .feature-bullets svg {
    flex-shrink: 0;
    color: var(--amber-500);
    transform: translateY(2px);
  }

  .shot {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid rgba(244, 239, 230, 0.1);
    box-shadow:
      0 30px 70px -25px rgba(0, 0, 0, 0.75),
      0 0 80px -35px rgba(253, 160, 45, 0.35);
    background: var(--ink-850);
  }

  .provider-network {
    margin-top: 3rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgba(244, 239, 230, 0.1);
  }

  .provider-network p {
    color: var(--paper-500);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-align: center;
  }

  .provider-network ul {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    align-items: center;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
  }

  .provider-network li {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 2.5rem;
  }

  .provider-network img {
    max-width: 100%;
    max-height: 2.6rem;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.78;
  }

  video {
    display: block;
    width: 100%;
    aspect-ratio: 7 / 4;
    object-fit: cover;
    background: var(--ink-900);
  }

  figcaption {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.75rem 1rem;
    color: var(--paper-500);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    background: var(--ink-850);
    border-top: 1px solid rgba(244, 239, 230, 0.07);
  }

  .live-mark {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--amber-500);
    box-shadow: 0 0 0 0.25rem rgba(253, 160, 45, 0.12);
  }

  @media (max-width: 60rem) {
    .feature-inner {
      grid-template-columns: 1fr;
    }
    .provider-network ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 1.5rem;
    }
  }
</style>
