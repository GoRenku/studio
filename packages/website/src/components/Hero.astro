---
import AgentWorkspace from './AgentWorkspace.astro';
import LaunchFilm from './LaunchFilm.astro';
import { site } from '../data/site';
---

<section class="hero" id="top">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="container hero-inner">
    <p class="eyebrow" data-reveal>For live-action, hybrid & fully AI films</p>
    <h1 data-reveal style="--reveal-delay: 0.08s">
      Watch your film while you’re <em>still writing it.</em>
    </h1>
    <p class="hero-sub" data-reveal style="--reveal-delay: 0.16s">
      Bring your screenplay into a studio where you can develop its look,
      stage the action, and direct AI-generated scenes—then carry what you
      discover into your next draft.
    </p>
    <div class="hero-actions" data-reveal style="--reveal-delay: 0.24s">
      <a href={site.downloadUrl} class="btn btn-primary">Download Renku</a>
      <a href="#features" class="btn btn-ghost">Explore the studio</a>
    </div>
  </div>

  <div class="hero-film" data-reveal style="--reveal-delay: 0.34s">
    <LaunchFilm />
  </div>

  <div class="hero-visual" data-reveal>
    <AgentWorkspace />
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(6.5rem, 12vh, 8rem);
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    inset: -20% -10% auto;
    height: 46rem;
    background:
      radial-gradient(
        42rem 24rem at 22% 18%,
        rgba(253, 160, 45, 0.16),
        transparent 65%
      ),
      radial-gradient(
        38rem 22rem at 80% 8%,
        rgba(229, 54, 95, 0.1),
        transparent 65%
      ),
      radial-gradient(
        30rem 20rem at 55% 30%,
        rgba(30, 179, 176, 0.07),
        transparent 60%
      );
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    text-align: center;
    max-width: 56rem;
  }

  h1 {
    font-size: clamp(2.6rem, 6.4vw, 4.6rem);
    margin-top: 1.25rem;
  }

  h1 em {
    font-style: italic;
    font-weight: 400;
    color: var(--amber-400);
  }

  .hero-sub {
    margin: 1.5rem auto 0;
    max-width: 43rem;
    text-wrap: pretty;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    color: var(--paper-300);
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 2.25rem;
    flex-wrap: wrap;
  }

  .hero-visual {
    position: relative;
    width: min(80rem, calc(100% - 5rem));
    margin: clamp(2.75rem, 6vh, 4rem) auto 0;
  }

  .hero-film {
    position: relative;
    width: min(64rem, calc(100% - 5rem));
    margin: clamp(2rem, 4vh, 3rem) auto 0;
  }
</style>
