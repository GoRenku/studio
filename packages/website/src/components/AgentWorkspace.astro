---
import { Image } from 'astro:assets';
import codexDirection from '../assets/screens/codex-film-direction.png';
import studioReview from '../assets/screens/studio-generation-review-clean.jpg';
---

<div
  class="workspace-pair"
  data-agent-workspace
  style={`--codex-column: ${codexDirection.width / codexDirection.height}fr; --studio-column: ${studioReview.width / studioReview.height}fr;`}
>
  <figure class="workspace codex-workspace">
    <figcaption class="workspace-heading">
      <span class="eyebrow">Codex Desktop</span>
    </figcaption>
    <button class="workspace-capture" style={`aspect-ratio: ${codexDirection.width} / ${codexDirection.height};`} aria-label="Enlarge Codex Desktop screenshot" data-screenshot={codexDirection.src} data-caption="Codex Desktop — direction, skills, and tools">
      <Image
        src={codexDirection}
        alt="Actual Codex Desktop conversation: the filmmaker asks to cut a repeated line without regenerating the scene. The agent edits the picture and sound, saves the revised clip, and displays the result."
        widths={[600, 900, 1200]}
        sizes="(max-width: 48rem) 85vw, 30rem"
        loading="eager"
        fetchpriority="high"
      />
    </button>
  </figure>

  <figure class="workspace studio-workspace">
    <figcaption class="workspace-heading">
      <span class="eyebrow">Renku Studio</span>
    </figcaption>
    <button class="workspace-capture" style={`aspect-ratio: ${studioReview.width} / ${studioReview.height};`} aria-label="Enlarge Renku Studio screenshot" data-screenshot={studioReview.src} data-caption="Renku Studio — previs and the revised generation">
      <Image
        src={studioReview}
        alt="Actual Renku Studio shot plan showing the Blender previs beside the revised generation labelled Duplicate removed, with dialogue and action cues underneath."
        widths={[900, 1400, 1800]}
        sizes="(max-width: 48rem) 85vw, 45rem"
        loading="eager"
        fetchpriority="high"
      />
    </button>
  </figure>
  <dialog class="workspace-inspector" aria-label="Screenshot detail">
    <div class="inspector-toolbar">
      <p data-inspector-title></p>
      <form method="dialog"><button class="inspector-close">Close</button></form>
    </div>
    <img class="inspector-image" alt="" />
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-agent-workspace]').forEach((workspace) => {
    const dialog = workspace.querySelector<HTMLDialogElement>('dialog')!;
    const image = dialog.querySelector<HTMLImageElement>('img')!;
    const title = dialog.querySelector<HTMLElement>('[data-inspector-title]')!;
    workspace.querySelectorAll<HTMLButtonElement>('[data-screenshot]').forEach((button) => {
      button.addEventListener('click', () => {
        image.src = button.dataset.screenshot!;
        image.alt = button.querySelector('img')!.alt;
        title.textContent = button.dataset.caption!;
        dialog.showModal();
      });
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>

<style>
  .workspace-pair {
    display: grid;
    grid-template-columns: minmax(0, var(--codex-column)) minmax(0, var(--studio-column));
    gap: 0 clamp(1.5rem, 2.5vw, 2rem);
    align-items: start;
  }

  .workspace {
    min-width: 0;
    margin: 0;
  }

  .workspace-heading {
    padding: 0 0 1rem;
  }

  .workspace-heading .eyebrow {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
  }

  .workspace-capture {
    appearance: none;
    display: block;
    width: 100%;
    padding: 0;
    overflow: hidden;
    cursor: zoom-in;
    background: var(--ink-850);
    border-radius: var(--radius-lg);
    border: 0;
    outline: 1px solid rgba(244, 239, 230, 0.1);
    outline-offset: -1px;
    box-shadow: 0 30px 70px -25px rgba(0, 0, 0, 0.75);
  }

  .workspace-capture:focus-visible, .inspector-close:focus-visible {
    outline: 2px solid var(--amber-400);
    outline-offset: 5px;
  }

  .workspace-capture img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .workspace-inspector {
    width: fit-content;
    max-width: min(96vw, 106rem);
    max-height: 94vh;
    padding: 0 1rem 1rem;
    color: var(--paper-100);
    background: var(--ink-850);
    border: 1px solid var(--ink-600);
    border-radius: var(--radius-lg);
  }

  .workspace-inspector::backdrop {
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(6px);
  }

  .inspector-toolbar {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1rem 0;
    background: var(--ink-850);
    font-size: 0.9rem;
  }

  .inspector-close {
    padding: 0.45rem 1rem;
    border: 1px solid var(--ink-600);
    border-radius: 2rem;
    color: var(--paper-100);
    background: var(--ink-800);
    font: inherit;
    cursor: pointer;
  }

  .inspector-image {
    border-radius: var(--radius-md);
  }

  @media (max-width: 48rem) {
    .workspace-pair {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
