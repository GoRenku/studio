{
  "name": "@gorenku/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Marketing website for Renku — the filmmaking studio for live action and AI.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/prepare-sites-build.mjs",
    "build:cloudflare": "astro build",
    "deploy:cloudflare": "pnpm run build:cloudflare && wrangler pages deploy dist --project-name renku-web --branch main",
    "preview": "astro preview",
    "check": "astro check",
    "type-check": "astro check"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.9",
    "astro": "^7.0.6",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^6.0.3",
    "wrangler": "^4.118.0"
  }
}
